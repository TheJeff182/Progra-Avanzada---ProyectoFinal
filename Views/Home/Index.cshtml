@{
    ViewData["Title"] = "Inicio";
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    var isAdmin = User.IsInRole("Admin");
    var isVentas = User.IsInRole("Ventas");
    var isOperaciones = User.IsInRole("Operaciones");
}

@if (!isAuthenticated)
{
    <div class="hero-panel p-4 p-lg-5 mb-4 text-center">
        <span class="badge bg-light text-primary mb-3">PixelTico - Gestor de Inventario</span>
        <h1 class="display-6 fw-bold">Bienvenido a PixelTico</h1>
        <p class="lead mb-4">
            Sistema de gestion de catalogo de consolas, videojuegos, accesorios, Funko Pop y mucho mas.
        </p>
        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Account" asp-action="Login" class="btn btn-light btn-lg px-4">Iniciar sesión</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg px-4">Crear cuenta</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <i class="bi bi-box-seam display-5 text-primary mb-3"></i>
                    <h5 class="card-title">Catálogo</h5>
                    <p class="text-muted mb-0">Consolas, videojuegos, accesorios y más, con control de stock en tiempo real.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <i class="bi bi-cart-check display-5 text-warning mb-3"></i>
                    <h5 class="card-title">Ventas</h5>
                    <p class="text-muted mb-0">Registra pedidos con búsqueda de productos y cálculo de totales en vivo.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <i class="bi bi-graph-up display-5 text-info mb-3"></i>
                    <h5 class="card-title">Reportes</h5>
                    <p class="text-muted mb-0">Historial de ventas, stock bajo y métricas de la tienda.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-light border text-center mb-0">
        Inicia sesión para acceder a estas funciones. ¿No tienes cuenta? <a asp-controller="Account" asp-action="Register">Regístrate aquí</a>.
    </div>
}
else
{
    <div class="hero-panel p-4 p-lg-5 mb-4">
        <span class="badge bg-light text-primary mb-3">PixelTico - Gestor de Inventario</span>
        <h1 class="display-6 fw-bold">Bienvenido a PixelTico</h1>
        <p class="lead mb-3">
            Sistema de gestion de catalogo de consolas, videojuegos, accesorios, Funko Pop y mucho mas.
        </p>
        <p class="mb-0">
            Comienza explorando el <strong>Catalogo de Productos</strong> desde el menu superior.
        </p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Productos</h5>
                    <p class="fs-3 fw-bold text-primary">Gestiona tu catalogo</p>
                    <a asp-controller="Productos" asp-action="Index" class="btn btn-primary btn-sm">Ir a Productos</a>
                </div>
            </div>
        </div>

        @if (isAdmin || isVentas)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="card-title">Clientes</h5>
                        <p class="fs-3 fw-bold text-success">Administra tus clientes</p>
                        <a asp-controller="Clientes" asp-action="Index" class="btn btn-success btn-sm">Ir a Clientes</a>
                    </div>
                </div>
            </div>
        }

        @if (isAdmin || isVentas)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="card-title">Ventas</h5>
                        <p class="fs-3 fw-bold text-warning">Registra una venta</p>
                        <a asp-controller="Ventas" asp-action="Index" class="btn btn-warning btn-sm">Nueva Venta</a>
                    </div>
                </div>
            </div>
        }

        @if (isAdmin || isVentas || isOperaciones)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="card-title">Pedidos</h5>
                        <p class="fs-3 fw-bold text-dark">Historial de ventas</p>
                        <a asp-controller="Pedidos" asp-action="Index" class="btn btn-dark btn-sm">Ver Historial</a>
                    </div>
                </div>
            </div>
        }

        @if (isAdmin)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="card-title">Usuarios</h5>
                        <p class="fs-3 fw-bold text-secondary">Gestiona roles</p>
                        <a asp-controller="Usuarios" asp-action="Index" class="btn btn-secondary btn-sm">Ir a Usuarios</a>
                    </div>
                </div>
            </div>
        }

        @if (isAdmin)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="card-title">Reportes</h5>
                        <p class="fs-3 fw-bold text-info">Ventas, stock y metricas</p>
                        <a asp-controller="Prototipos" asp-action="Reportes" class="btn btn-info btn-sm">Ver Reportes</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
