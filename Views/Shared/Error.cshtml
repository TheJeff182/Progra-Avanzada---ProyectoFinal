@model ProyectoFinal.Models.ErrorViewModel
@{
    var codigo = Model.StatusCode ?? 500;
    ViewData["Title"] = codigo == 404 ? "Página no encontrada" : "Error";
    var emoji = codigo == 404 ? "🔍" : "⚠️";
    var titulo = codigo == 404 ? "Página no encontrada (404)" : "Ocurrió un error (500)";
    var mensaje = codigo == 404
        ? "La página que buscas no existe o fue movida."
        : "Algo salió mal al procesar tu solicitud.";
}

<div class="text-center py-5">
    <p style="font-size:4rem;">@emoji</p>
    <h2 class="fw-semibold mb-2">@titulo</h2>
    <p class="text-muted mb-4">@mensaje</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted" style="font-size:0.8rem;">
            Request ID: <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-sm px-4">
        Volver al inicio
    </a>
</div>
